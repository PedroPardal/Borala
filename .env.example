# Copie para .env e preencha com o firebaseConfig do app Web do seu projeto
# (Console do Firebase > Configurações do projeto > Seus apps > SDK setup and configuration).
# Esses valores identificam o projeto e vão dentro do app; a proteção dos dados fica nas regras
# (firestore.rules e storage.rules).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# AdMob (opcional). Sem estes valores o app usa os anuncios de TESTE do Google.
# IDs dos blocos de anuncio (ca-app-pub-XXXX/YYYY), criados em admob.google.com > Apps > Blocos de anuncios.
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
