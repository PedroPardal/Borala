rules_version = '2';

// Regras do BoraLá. Publique em: Console do Firebase > Firestore Database > Regras
// (ou `npx firebase-tools deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUser(id) { return signedIn() && request.auth.uid == id; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function text(v, max) { return v is string && v.size() <= max; }
    // coleção e id em segmentos separados: um "/" dentro de $(...) não divide o caminho
    function docAt(coll, id) { return /databases/$(database)/documents/$(coll)/$(id); }

    // Perfil privado da conta: só o dono lê e escreve. O e-mail não muda; o papel alterna
    // entre cliente e prestador (a mesma conta pode contratar e divulgar serviços).
    match /users/{userId} {
      allow read: if isUser(userId);
      allow create: if isUser(userId)
        && request.resource.data.role in ['client', 'provider']
        && text(request.resource.data.name, 80);
      allow update: if isUser(userId)
        && request.resource.data.role in ['client', 'provider']
        && request.resource.data.email == resource.data.email
        && text(request.resource.data.name, 80);
      allow delete: if false;
    }

    // Perfil público do prestador.
    match /providers/{providerId} {
      allow read: if signedIn();

      allow create: if isUser(providerId)
        && getAfter(docAt('users', providerId)).data.role == 'provider'
        && request.resource.data.rating == 0
        && request.resource.data.reviewsCount == 0
        && request.resource.data.completedJobs == 0
        && !('blockedForDebt' in request.resource.data)
        && !('acceptsOnlinePayment' in request.resource.data);

      // O dono edita o próprio perfil, menos a nota e os campos que só a Cloud Function grava
      // (serviços concluídos, bloqueio por débito e se recebe pagamentos no app).
      // Outro usuário só mexe na nota, e só junto com uma avaliação nova dele para este prestador.
      allow update: if (
          isUser(providerId)
          && !changed().hasAny(['rating', 'reviewsCount', 'lastReviewId', 'blockedForDebt', 'acceptsOnlinePayment', 'completedJobs'])
        ) || (
          signedIn() && !isUser(providerId)
          && changed().hasOnly(['rating', 'reviewsCount', 'lastReviewId'])
          && request.resource.data.reviewsCount == resource.data.reviewsCount + 1
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && !exists(docAt('reviews', request.resource.data.lastReviewId))
          && getAfter(docAt('reviews', request.resource.data.lastReviewId)).data.providerId == providerId
          && getAfter(docAt('reviews', request.resource.data.lastReviewId)).data.clientId == request.auth.uid
        );
      allow delete: if false;
    }

    // Uma avaliação por pedido (o id é o id do pedido), só de pedido concluído do próprio cliente.
    match /reviews/{bookingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && text(request.resource.data.comment, 1000)
        && get(docAt('bookings', bookingId)).data.clientId == request.auth.uid
        && get(docAt('bookings', bookingId)).data.providerId == request.resource.data.providerId
        && get(docAt('bookings', bookingId)).data.status == 'concluido';
      allow update, delete: if false;
    }

    // Pedidos: só cliente e prestador envolvidos enxergam.
    match /bookings/{bookingId} {
      function isClient() { return resource.data.clientId == request.auth.uid; }
      function isProvider() { return resource.data.providerId == request.auth.uid; }

      allow read: if signedIn() && (isClient() || isProvider());

      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.providerId != request.auth.uid
        && exists(docAt('providers', request.resource.data.providerId))
        && request.resource.data.status == 'pendente'
        && request.resource.data.reviewed == false
        && request.resource.data.price is number && request.resource.data.price > 0
        // comissão: 8% do serviço com mínimo de R$ 5 (a Cloud Function usa platformFee no débito do prestador)
        && request.resource.data.servicePrice is number && request.resource.data.servicePrice > 0
        && request.resource.data.platformFee is number
        && request.resource.data.platformFee >= 5
        && request.resource.data.platformFee >= request.resource.data.servicePrice * 0.08 - 0.01
        && request.resource.data.price >= request.resource.data.servicePrice + request.resource.data.platformFee - 0.01
        && request.resource.data.payment in ['pix', 'cartao', 'dinheiro']
        && !request.resource.data.keys().hasAny(['payout', 'paymentStatus', 'disputed', 'concludedBy', 'cancelledBy'])
        // Pix e cartão só com prestador que tem conta de recebimento no Asaas
        && (request.resource.data.payment == 'dinheiro'
            || get(docAt('providers', request.resource.data.providerId)).data.get('acceptsOnlinePayment', false) == true)
        // com comissões acima do limite, o prestador só recebe pedidos pagos no app (que quitam o débito)
        && (request.resource.data.payment != 'dinheiro'
            || get(docAt('providers', request.resource.data.providerId)).data.get('blockedForDebt', false) != true)
        && text(request.resource.data.address, 300);

      // Cliente: atualiza a cópia do próprio nome/foto, marca como avaliado (junto com a avaliação),
      // cancela enquanto pendente, confirma que o serviço foi feito ou reporta um problema.
      // Prestador: atualiza a cópia do nome/foto e o status, seguindo pendente → aceito/recusado → concluído.
      // Pedido por Pix ou cartão só pode ser aceito depois de pago. Pagamento e repasse: só a Cloud Function.
      allow update: if signedIn() && (
        (isClient()
          && changed().hasOnly(['clientName', 'clientAvatar', 'reviewed', 'status', 'disputed'])
          && (!changed().hasAny(['reviewed'])
              || (request.resource.data.reviewed == true && existsAfter(docAt('reviews', bookingId))))
          && (!changed().hasAny(['status'])
              || (resource.data.status == 'pendente' && request.resource.data.status == 'cancelado')
              || (resource.data.status == 'aceito' && request.resource.data.status == 'concluido'
                  && resource.data.get('disputed', false) != true))
          && (!changed().hasAny(['disputed'])
              || (request.resource.data.disputed == true && resource.data.status == 'aceito')))
        || (isProvider()
          && changed().hasOnly(['status', 'providerName', 'providerAvatar'])
          && (!changed().hasAny(['status'])
              || (resource.data.status == 'pendente' && request.resource.data.status == 'recusado')
              || (resource.data.status == 'pendente' && request.resource.data.status == 'aceito'
                  && (resource.data.payment == 'dinheiro' || resource.data.get('paymentStatus', '') == 'pago'))
              || (resource.data.status == 'aceito' && request.resource.data.status == 'concluido'
                  && resource.data.get('disputed', false) != true)))
      );
      allow delete: if false;
    }

    // Cobrança do Asaas de um pedido (QR Code Pix, link do cartão). Só a Cloud Function grava.
    match /payments/{bookingId} {
      allow read: if signedIn() && resource.data.clientId == request.auth.uid;
      allow write: if false;
    }

    // Dados internos do Asaas (cliente e subconta do prestador): só o servidor acessa.
    match /asaasCustomers/{uid} {
      allow read, write: if false;
    }
    match /providerAccounts/{uid} {
      allow read, write: if false;
    }

    // Saldo do prestador (comissões de serviços pagos em dinheiro). Só a Cloud Function grava.
    match /providerBalances/{providerId} {
      allow read: if isUser(providerId);
      allow write: if false;
      match /entries/{entryId} {
        allow read: if isUser(providerId);
        allow write: if false;
      }
    }

    // Horários ocupados, públicos para montar a agenda sem expor os pedidos.
    // O id é "prestador_data_hora": criar um id que já existe conta como update e é recusado,
    // então dois clientes não conseguem reservar o mesmo horário.
    match /busySlots/{slotId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid
        && slotId == request.resource.data.providerId + '_' + request.resource.data.date + '_' + request.resource.data.time
        && getAfter(docAt('bookings', request.resource.data.bookingId)).data.clientId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.providerId == request.auth.uid || resource.data.clientId == request.auth.uid);
    }

    // Fotos (perfil e antes/depois) como JPEG em base64, já reduzidas no celular.
    // O id começa com o uid do dono; ninguém altera a foto de outra pessoa.
    match /photos/{photoId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && photoId.matches(request.auth.uid + '_[a-z0-9]+')
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
      allow update: if false;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // Conversa entre um cliente e um prestador (id "cliente_prestador").
    match /conversations/{convId} {
      // resource == null permite checar se a conversa já existe antes de criar
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if signedIn()
        && request.auth.uid in [request.resource.data.clientId, request.resource.data.providerId]
        && request.resource.data.participants == [request.resource.data.clientId, request.resource.data.providerId]
        && convId == request.resource.data.clientId + '_' + request.resource.data.providerId;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && changed().hasOnly(['lastMessage', 'updatedAt', 'clientName', 'clientAvatar', 'providerName', 'providerAvatar']);
      allow delete: if false;

      match /messages/{messageId} {
        function isMember() {
          return request.auth.uid in get(docAt('conversations', convId)).data.participants;
        }
        allow read: if signedIn() && isMember();
        allow create: if signedIn() && isMember()
          && request.resource.data.senderId == request.auth.uid
          && text(request.resource.data.text, 2000)
          && request.resource.data.text.size() > 0;
        allow update, delete: if false;
      }
    }
  }
}
